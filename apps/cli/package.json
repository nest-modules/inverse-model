{
  "name": "@nestjs-modules/inverse",
  "version": "0.1.0",
  "description": "Generates a NestJS GraphQL starter project from an existing database.",
  "license": "MIT",
  "author": "juandav <e.juandav@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nest-modules/inverse-model.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/nest-modules/inverse-model/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/nest-modules/inverse-model/issues"
  },
  "keywords": [
    "nest",
    "nestjs",
    "nestjs-modules",
    "graphql",
    "database",
    "generator",
    "cli"
  ],
  "type": "commonjs",
  "bin": {
    "inverse": "./dist/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@nestjs-modules/inverse-generator": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "nest-commander": "3.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "jest": "30.5.2",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  }
}
