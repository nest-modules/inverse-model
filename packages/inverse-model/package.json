{
  "name": "@nestjs-modules/inverse-model",
  "version": "0.1.0",
  "description": "Mounts a GraphQL API over an existing database from its connection string.",
  "license": "MIT",
  "author": "juandav <e.juandav@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nest-modules/inverse-model.git",
    "directory": "packages/inverse-model"
  },
  "homepage": "https://github.com/nest-modules/inverse-model#readme",
  "bugs": {
    "url": "https://github.com/nest-modules/inverse-model/issues"
  },
  "keywords": [
    "nest",
    "nestjs",
    "nestjs-modules",
    "graphql",
    "database",
    "postgres",
    "mysql",
    "mariadb",
    "sqlserver",
    "mongodb",
    "typeorm"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drivers": {
      "types": "./dist/drivers.d.ts",
      "default": "./dist/drivers.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js -c jest.integration.config.js",
    "prepack": "node -e \"fs.copyFileSync('../../README.md', 'README.md')\""
  },
  "devDependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "graphql": "17.0.2",
    "ioredis": "5.11.1",
    "jest": "30.5.2",
    "mongodb": "7.7.0",
    "mssql": "12.7.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.14",
    "typeorm": "1.1.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@apollo/server": "^5.0.0",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/graphql": "^14.0.0",
    "graphql": "^16.11.0 || ^17.0.0",
    "ioredis": "^5.0.0",
    "mongodb": "^7.0.0",
    "mssql": "^12.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.5.1",
    "typeorm": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "dependencies": {
    "dataloader": "2.2.3"
  }
}
